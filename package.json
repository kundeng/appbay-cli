{
  "name": "appbay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "generate:system-apps": "node scripts/generate-system-apps.mjs",
    "check:system-apps": "node scripts/generate-system-apps.mjs --check",
    "check:docs-cli": "node scripts/check-docs-cli.mjs",
    "check:straddle": "node scripts/check-straddle.mjs",
    "check:docs-manifests": "node scripts/check-docs-manifests.mjs",
    "check:subset": "node scripts/check-subset.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
