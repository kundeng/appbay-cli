# Generated by AppBay — do not edit manually
authorization policy appbay_demo {
	set auth url https://demo.lab.example.com/auth
	crypto key verify {$APPBAY_EDGE_TOKEN_SECRET}
	allow roles authp/admin authp/user
	enable strip token
	inject header "Remote-User" from sub
	inject header "Remote-Email" from email
	inject header "Remote-Groups" from roles
}
